    "test:ecosystem": "tsx test/mfs-customer-ecosystem.test.ts",
    "test:all": "tsx test/backend-api.test.ts && tsx test/security-audit.test.ts && tsx test/mfs-customer-ecosystem.test.ts",
    "seed": "node scripts/seed.js",
    "seed:behavior": "node scripts/seed-behavior.js",
