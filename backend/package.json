{
  "name": "upay-sentinel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "upay Sentinel — Backend Intelligence Layer (Express REST APIs, Supabase PostgreSQL, ML Risk Engine, Gemini Sentinel Copilot)",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "test": "tsx test/backend-api.test.ts",
